# Local SQLite setup (default)
DATABASE_URL="file:./dev.db"

# For Neon PostgreSQL deployment on Vercel:
# 1. Update prisma/schema.prisma datasource provider to "postgresql"
# 2. Set DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://..."

NEXTAUTH_SECRET="your-generated-random-secret-key-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Protects the daily reminder job (/api/cron/reminders). Vercel Cron sends it automatically.
# Generate with: openssl rand -hex 32. Without it the job refuses to run.
CRON_SECRET=""

NEXT_PUBLIC_MSME_INTEREST_RATE_ANNUAL=16.5

# --- Optional External Service Providers ---

# 1. Email Delivery Provider (Resend / SMTP)
# Leave empty to use the built-in simulated delivery logger (nothing is sent). Any value here = real sending.
RESEND_API_KEY=""
EMAIL_FROM="Settlr Notices <notices@yourdomain.com>"

# 2. WhatsApp Business Cloud API (Swappable without code changes)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# 3. Vision LLM OCR (Google Gemini / OpenAI)
# If not configured, Settlr uses heuristic & simulated parsing for offline testing
GEMINI_API_KEY=""
OPENAI_API_KEY=""

